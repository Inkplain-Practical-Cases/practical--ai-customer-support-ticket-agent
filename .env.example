# Provider selection (fake = offline and deterministic).
CLASSIFIER_PROVIDER=fake
# OpenAI key, if using live provider. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Use memory for tests, postgres for durable support tickets.
TICKET_STORE=memory
DATABASE_URL=postgresql://northstar:local_dev_only@localhost:5432/northstar
POSTGRES_PASSWORD=local_dev_only
# Maximum seconds for each model stage (0 < value <= 120).
MODEL_TIMEOUT_SECONDS=15

# Choose memory for offline runs or postgres for durable storage.
TICKET_STORE=memory
# Example ONLY: local Docker credentials; use a protected secret in production.
DATABASE_URL=postgresql://northstar:local_dev_only@localhost:5432/northstar
# Docker PostgreSQL password. Never commit real credentials.
POSTGRES_PASSWORD=local_dev_only
# AI provider selection; fake is deterministic.
CLASSIFIER_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
